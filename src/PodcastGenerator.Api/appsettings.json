{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Episodes": {
    "MinDurationMin": 5,
    "MaxDurationMin": 60
  },
  "Llm": {
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "Model": "gemini-3.5-flash",
    "FallbackModel": "gemini-3.5-flash-lite",
    "ApiKey": "",
    "ReasoningEffort": "low",
    "RequestsPerMinute": 10,
    "MaxRetries": 5,
    "BaseDelayMs": 2000,
    "OverloadBaseDelayMs": 10000,
    "MaxTimeoutRetries": 1,
    "MaxDelaySeconds": 60,
    "TimeoutSeconds": 120
  },
  "Worker": {
    "Enabled": true,
    "PollIntervalMs": 2000,
    "LeaseSeconds": 60
  },
  "Tts": {
    "Budgets": {
      "WaveNet": {
        "MonthlyChars": 900000
      },
      "Chirp3HD": {
        "MonthlyChars": 900000
      }
    },
    "DefaultVoices": {
      "WaveNet": "de-DE-Wavenet-B",
      "Chirp3HD": "de-DE-Chirp3-HD-Charon"
    },
    "CharsPerWord": 7.0,
    "Google": {
      "BaseUrl": "https://texttospeech.googleapis.com/v1/",
      "ApiKey": "",
      "SampleRateHertz": 24000,
      "TimeoutSeconds": 60
    }
  },
  "Storage": {
    "LocalPath": "audio-storage"
  }
}
