    "RequestsPerMinute": 10,
    "MaxRetries": 5,
    "BaseDelayMs": 2000,
    "MaxDelaySeconds": 60,
    "TimeoutSeconds": 180
  },
  "Worker": {
    "Enabled": true,
    "PollIntervalMs": 2000,
    "LeaseSeconds": 60
  }
}
