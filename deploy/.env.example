# Copy to .env next to docker-compose.yml on the server, fill in, then: chmod 600 .env
# Never commit the real file (.env is git-ignored).

# Public hostname. With no domain, use your server's IP with dashes: 203-0-113-7.sslip.io
# Use :80 to try the stack locally over plain HTTP.
SITE_ADDRESS=

# Random secrets. Generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=

# New accounts need this code. Leave empty only if you really want anyone to be able to sign up:
# every account can create episodes, which uses your Gemini and Text-to-Speech quotas.
INVITE_CODE=

# Provider keys. Use keys made for this server, not the ones on your laptop.
LLM_API_KEY=
TTS_API_KEY=

# Images to run. The defaults are the ones GitHub Actions publishes from main.
# API_IMAGE=ghcr.io/lauta136/podcast-generator-api:latest
# WEB_IMAGE=ghcr.io/lauta136/podcast-generator-web:latest
